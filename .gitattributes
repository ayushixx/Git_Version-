# GitHub Linguist Language Override
# Ensures GitHub computes C++ as the primary repository language
*.html linguist-detectable=false
*.css linguist-detectable=false
*.js linguist-detectable=false
*.json linguist-detectable=false
*.svg linguist-detectable=false
*.md linguist-detectable=false
*.txt linguist-detectable=false
Makefile linguist-detectable=false

# Keep C++ files detectable and prominent
*.cpp linguist-detectable=true
*.hpp linguist-detectable=true
*.h linguist-detectable=true
CMakeLists.txt linguist-detectable=true

# Git line ending normalization
* text=auto eol=lf
